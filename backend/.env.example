# backend/.env.example
# Django
DJANGO_SECRET_KEY=your-secret-key-here-generate-with-django-secret-key-generator
DJANGO_DEBUG=False
# Production also auto-adds healthcheck.railway.app and RAILWAY_PUBLIC_DOMAIN.
# Production: 3rb-extreme-backend Railway hostname (plus healthcheck.railway.app)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ENVIRONMENT=production

# PostgreSQL (the platform's only supported database).
# Local development: `docker compose up -d` from the repository root starts a
# matching PostgreSQL 16 service (see docker-compose.yml); these defaults point
# straight at it.
# Railway Postgres plugin injects DATABASE_URL. When set, it overrides POSTGRES_*.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_DB=financial_ops
POSTGRES_USER=financial_ops_user
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Disposable pytest database; must start with test_ and must never equal POSTGRES_DB.
POSTGRES_TEST_DB=test_financial_ops_efop_33_1
POSTGRES_CONN_MAX_AGE=60

# CORS / CSRF (production: https origins of the frontend + API host)
# Production frontend: https://3rb-extreme.vercel.app
# Update these when a custom domain is added.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL (documented for operators; CORS/CSRF lists above are what Django reads)
FRONTEND_URL=http://localhost:3000

# Railway (and similar proxies) overwrite X-Forwarded-For. Leave False locally.
TRUST_X_FORWARDED_FOR=False

# Celery (for future use)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Shared cache (login rate limiting + health throttling live here).
# Local development: the redis service in docker-compose.yml matches this URL.
# REQUIRED in production: without it, production settings refuse to boot
# (per-worker LocMemCache would silently defeat the rate limits).
REDIS_URL=redis://localhost:6379/0

# Email (SMTP) — replace with real values at deployment
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=grp3rb@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=3.R.B Extreme <grp3rb@gmail.com>
EMAIL_API_URL=
EMAIL_API_KEY=

# Twilio (SMS + WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Security (production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
# Optional strict production CSP override
CONTENT_SECURITY_POLICY=

USE_CLOUDFLARE_R2=False
USE_S3_STORAGE=True
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=efop-files
R2_ACCOUNT_ID=
R2_REGION=auto
# Optional override. If empty, settings build this from R2_ACCOUNT_ID:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
AWS_LOCATION=private

# Sentry (production)
SENTRY_DSN_BACKEND=
