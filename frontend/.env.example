# Frontend Environment Variables Example
# Copy to .env.local for local development

# Browser-side API base URL.
# Default: same-origin '/api/v1' — requests go to the Next.js origin and are
# proxied to Django by src/app/api/v1/[[...path]]/route.ts. This is what makes
# the HttpOnly cookie session work with no CORS exposure.
# Only set an absolute URL here if you deliberately want the browser to talk
# directly to Django (then that origin must be in the backend's CORS and
# CSRF_TRUSTED_ORIGINS allow-lists).
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-side only (never exposed to the browser): where the proxy route
# forwards API requests. REQUIRED — the proxy throws at boot if this is missing.
# Must be an absolute http(s) URL.
# Production: https://3rb-extreme.up.railway.app/api/v1
BACKEND_INTERNAL_URL=http://127.0.0.1:8000/api/v1

# Used by Sentry tracePropagationTargets. Production: Railway origin.
NEXT_PUBLIC_API_URL=https://3rb-extreme.up.railway.app

# Sentry — set these on Vercel (Project → Settings → Environment Variables):
# NEXT_PUBLIC_SENTRY_DSN
# SENTRY_AUTH_TOKEN
# SENTRY_ORG
# SENTRY_PROJECT
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=group-3rb
SENTRY_PROJECT=3rb-frontend

